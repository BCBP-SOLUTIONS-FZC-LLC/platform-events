#!/usr/bin/env bash
# Local commit gates: module tidiness, formatting and lint — the same checks
# CI's Validate / Quality job runs first. Installed by `make setup` /
# `make install-hooks`; bypass once with `git commit --no-verify`.
set -euo pipefail

echo "[pre-commit] running tidy..."
make tidy
# CI fails on go.mod/go.sum drift; tidy may just have fixed it in the working
# tree, but the fix is not part of this commit until it is staged.
if ! git diff --quiet -- go.mod go.sum; then
  echo "[pre-commit] go mod tidy changed go.mod/go.sum — review and 'git add go.mod go.sum', then commit again." >&2
  exit 1
fi

echo "[pre-commit] running fmt-check..."
make fmt-check

echo "[pre-commit] running lint..."
make lint
