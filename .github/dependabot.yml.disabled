version: 2
updates:
  - package-ecosystem: gomod
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, go]

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, github-actions]

# DISABLED (temporarily) — GitHub only reads .github/dependabot.yml, so this renamed file
# stops scheduled version-update checks and new Dependabot PRs for gomod and
# github-actions without losing the configuration.
#
# Re-enable:  git mv .github/dependabot.yml.disabled .github/dependabot.yml
#
# Note: this does not turn off Dependabot *alerts* or *security updates* —
# those are repository settings (Settings → Code security).
