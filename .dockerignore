# Version control
.git
.gitignore

# Environment files — never bake secrets into the image
.env
.env.*
*.env
.go_private_token

# Development tooling, docs and the reference monitoring bundle — none are
# part of the image; excluding them keeps `COPY . .` from invalidating the
# build cache on a linter bump or dashboard edit. test/ and tools/ are their
# own Go modules, which the root module's build ignores anyway.
tools/
monitoring/
.claude/
.github/
docs/
scripts/
*.md

# Local compose (host-only)
docker-compose.yml
docker-compose.yaml

# Test artefacts
test/
coverage.out
coverage*.out
coverage.html
*.coverprofile
**/*_test.go

# Build artefacts already compiled outside Docker
bin/
.coverage/

# IDE and OS noise
.idea/
.vscode/
*.DS_Store
*.swp
*.swo

# Go tool cache (not needed in image)
vendor/
