# platform-events environment configuration
# Copy to .env: make setup

# Application
APP_NAME=platform-events
APP_ENV=development
BUILD_VERSION=dev

# AWS credentials (use instance role / IRSA in production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack endpoint (remove or leave empty for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566

# SNS Publisher
SNS_TOPIC_ARN=

# SQS Consumer
SQS_QUEUE_URL=
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=30s
SQS_CONCURRENCY=1

# Outbox Runner
OUTBOX_POLL_INTERVAL=5s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5

# Database (for outbox runner — uses platform-pgcommon DSN)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev?sslmode=disable

# OpenTelemetry
OTEL_SERVICE_NAME=platform-events
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Smoke tests (require live AWS resources)
SMOKE_SNS_TOPIC_ARN=
SMOKE_SQS_QUEUE_URL=
