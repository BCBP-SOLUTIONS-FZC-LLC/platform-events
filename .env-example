# platform-events environment configuration
# Copy to .env: make setup

# Application
# APP_NAME / APP_ENV also feed the Tier 1 metrics identity, exactly as in
# platform-pgcommon: service ← APP_NAME (events.MetricsIdentityFromEnv),
# environment ← APP_ENV, then ENVIRONMENT, else "dev" (events.InitMetrics).
APP_NAME=platform-events
APP_ENV=development
BUILD_VERSION=dev

# AWS credentials (use instance role / IRSA in production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack endpoint (remove or leave empty for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566

# SNS Publisher
SNS_TOPIC_ARN=

# SQS Consumer
SQS_QUEUE_URL=
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=30s
SQS_CONCURRENCY=1
# Set when using WithDeadLetterHandler. MUST be LOWER than the SQS queue RedrivePolicy
# maxReceiveCount — SQS stops delivering once the count exceeds maxReceiveCount, so with an
# equal or higher value the dead-letter handler never runs (queue maxReceiveCount=5 → 4).
# IMPORTANT: also wire events.WithDeadLetterHandler in your consumer — setting this env
# var alone does not activate DLH routing; you must pass WithDeadLetterHandler explicitly.
SQS_MAX_RECEIVE_COUNT=4

# Optional: sample platform_queue_depth / platform_dlq_depth every interval
# (e.g. 60s); needs sqs:GetQueueAttributes on the queue and its DLQ. Off when unset.
# SQS_QUEUE_DEPTH_INTERVAL=60s

# SNS→SQS subscription (Terraform/CDK — not a library env var):
#   RawMessageDelivery=true  (required — without it messages are deleted as malformed)

# Outbox Runner
OUTBOX_POLL_INTERVAL=5s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
# Unset = 10m store default (how long a claimed record is hidden from other runners)
OUTBOX_CLAIM_LEASE_DURATION=
# PRODUCTION: set to 5s–10s when running ≥2 runner replicas (K8s) to desync
# startup polls and avoid thundering-herd on the outbox_events table.
OUTBOX_STARTUP_JITTER=0s
OUTBOX_PUBLISH_CONCURRENCY=1
# PRODUCTION: set to 10s–30s based on worst-case SNS p99 latency.
# Set to -1s to disable per-record publish timeout entirely (not recommended
# in production — a hung SNS call will block the runner indefinitely).
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_DRAIN_TIMEOUT=30s

# Database (outbox runner / inbox) — read by platform-pgcommon's ConfigFromEnv
# via config.LoadOutbox().DB. DATABASE_URL, or PG_HOST / PG_PORT / PG_USER /
# PG_PASSWORD / PG_DBNAME / PG_SSLMODE; pool tuning (PG_MAX_CONNS,
# PG_STATEMENT_TIMEOUT, PG_LOCK_TIMEOUT, PG_BOUNCER_MODE, …) per platform-pgcommon.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_dev?sslmode=require
# Optional DDL-role DSN for outbox/inbox ApplySchema (direct to Postgres, not
# via PgBouncer); falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Tracing and logging: none here. platform-events reads no OTEL_* or log
# variables — the consuming service sets them for platform-gincommon's
# InitTracingFromEnv and injects its logger (port.Logger).

# Smoke tests (require live AWS resources)
SMOKE_SNS_TOPIC_ARN=
SMOKE_SQS_QUEUE_URL=
